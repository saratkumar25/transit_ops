<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transit_trip_list" model="ir.ui.view">
        <field name="name">transit.trip.list</field>
        <field name="model">transit.trip</field>
        <field name="arch" type="xml">
            <list string="Trips">
                <field name="name"/>
                <field name="source"/>
                <field name="destination"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="cargo_weight"/>
                <field name="planned_distance"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_transit_trip_form" model="ir.ui.view">
        <field name="name">transit.trip.form</field>
        <field name="model">transit.trip</field>
        <field name="arch" type="xml">
            <form string="Trip">
                <header>
                    <button name="action_dispatch" string="Dispatch" type="object" class="btn-primary" invisible="state != 'draft'" groups="transit_ops.group_transit_dispatcher"/>
                    <button name="action_complete" string="Complete" type="object" class="btn-primary" invisible="state != 'dispatched'" groups="transit_ops.group_transit_dispatcher"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'dispatched')" groups="transit_ops.group_transit_dispatcher"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,dispatched,completed,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group string="Route">
                            <field name="name"/>
                            <field name="source"/>
                            <field name="destination"/>
                            <field name="region"/>
                            <field name="planned_distance"/>
                        </group>
                        <group string="Assignment">
                            <field name="vehicle_id" domain="[('status','=','available')]"/>
                            <field name="driver_id" domain="[('status','=','available')]"/>
                            <field name="cargo_weight"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group string="Trip Metrics">
                        <field name="start_odometer" readonly="1"/>
                        <field name="final_odometer"/>
                        <field name="actual_distance" readonly="1"/>
                        <field name="fuel_consumed"/>
                        <field name="fuel_cost"/>
                        <field name="revenue"/>
                    </group>
                    <group string="Dates">
                        <field name="dispatch_date"/>
                        <field name="completion_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_transit_trip_search" model="ir.ui.view">
        <field name="name">transit.trip.search</field>
        <field name="model">transit.trip</field>
        <field name="arch" type="xml">
            <search string="Trips">
                <field name="name"/>
                <field name="source"/>
                <field name="destination"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Dispatched" name="dispatched" domain="[('state','=','dispatched')]"/>
                <filter string="Completed" name="completed" domain="[('state','=','completed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                    <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by':'vehicle_id'}"/>
                    <filter string="Driver" name="group_driver" context="{'group_by':'driver_id'}"/>
                    <filter string="Region" name="group_region" context="{'group_by':'region'}"/>
            </search>
        </field>
    </record>

    <record id="action_transit_trip" model="ir.actions.act_window">
        <field name="name">Trips</field>
        <field name="res_model">transit.trip</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_transit_trip_search"/>
    </record>
</odoo>
