<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Fuel Log List View                                            -->
    <!-- ============================================================ -->
    <record id="view_transit_fuel_log_list" model="ir.ui.view">
        <field name="name">transit.fuel.log.list</field>
        <field name="model">transit.fuel.log</field>
        <field name="arch" type="xml">
            <list string="Fuel Logs">
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="trip_id" optional="show"/>
                <field name="liters" sum="Total Liters"/>
                <field name="cost" sum="Total Cost"/>
                <field name="odometer"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Fuel Log Form View                                            -->
    <!-- ============================================================ -->
    <record id="view_transit_fuel_log_form" model="ir.ui.view">
        <field name="name">transit.fuel.log.form</field>
        <field name="model">transit.fuel.log</field>
        <field name="arch" type="xml">
            <form string="Fuel Log">
                <sheet>
                    <group>
                        <group string="Vehicle &amp; Trip">
                            <field name="vehicle_id"/>
                            <field name="trip_id"/>
                            <field name="date"/>
                        </group>
                        <group string="Fuel Details">
                            <field name="liters"/>
                            <field name="cost"/>
                            <field name="odometer"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Fuel Log Search View                                          -->
    <!-- ============================================================ -->
    <record id="view_transit_fuel_log_search" model="ir.ui.view">
        <field name="name">transit.fuel.log.search</field>
        <field name="model">transit.fuel.log</field>
        <field name="arch" type="xml">
            <search string="Fuel Logs">
                <field name="vehicle_id"/>
                <field name="trip_id"/>
                <separator/>
                <filter string="Vehicle" name="group_vehicle" context="{'group_by':'vehicle_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by':'date:month'}"/>
                
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Fuel Log Graph View                                           -->
    <!-- ============================================================ -->
    <record id="view_transit_fuel_log_graph" model="ir.ui.view">
        <field name="name">transit.fuel.log.graph</field>
        <field name="model">transit.fuel.log</field>
        <field name="arch" type="xml">
            <graph string="Fuel Analysis" type="bar">
                <field name="vehicle_id"/>
                <field name="cost" type="measure"/>
                <field name="liters" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Fuel Log Pivot View                                           -->
    <!-- ============================================================ -->
    <record id="view_transit_fuel_log_pivot" model="ir.ui.view">
        <field name="name">transit.fuel.log.pivot</field>
        <field name="model">transit.fuel.log</field>
        <field name="arch" type="xml">
            <pivot string="Fuel Analysis">
                <field name="vehicle_id" type="row"/>
                <field name="date" type="col" interval="month"/>
                <field name="cost" type="measure"/>
                <field name="liters" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Fuel Log Action                                               -->
    <!-- ============================================================ -->
    <record id="action_transit_fuel_log" model="ir.actions.act_window">
        <field name="name">Fuel &amp; Expenses</field>
        <field name="res_model">transit.fuel.log</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="search_view_id" ref="view_transit_fuel_log_search"/>
    </record>
</odoo>
